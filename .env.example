# GitHub personal access token, used to fetch each package's language breakdown
# (repos/{owner}/{repo}/languages). No scopes required for public repos.
# Without it, requests fall back to unauthenticated GitHub API calls (60/hour limit).
GITHUB_TOKEN=

# Canonical production URL, used for metadata, sitemap.xml, robots.txt and
# Open Graph tags. Set this to the real deployed domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://npm-package-comparator.vercel.app

# Google AdSense publisher/client ID (e.g. ca-pub-1234567890123456).
# Leave unset during development — ad slots render as labeled placeholders
# until this is set, and ads.txt won't publish a real entry without it.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
